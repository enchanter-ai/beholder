# The workspace plugins (packages/plugin-*) declare a peerDependency on the
# host SDK (`beholder`). That host is this repo's private root package, not a
# public npm package — the bare name `beholder` on the public registry is an
# unrelated project. Auto-installing peer deps (npm 7+ default) therefore pulls
# that unrelated package and pins it in the lockfile, which then breaks
# `npm ci`. The plugins consume the host types-only (via a local ambient .d.ts
# shim), so the peer dep is declarative for downstream consumers and must not
# be resolved from the registry here.
legacy-peer-deps=true
